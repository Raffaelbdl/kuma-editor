{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "outDir": "dist/launcher",
    "rootDir": "launcher",
    "sourceMap": true,
    "skipLibCheck": true
  },
  "include": ["launcher/**/*.ts"]
}
