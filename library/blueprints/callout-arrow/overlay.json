{
  "name": "Callout arrow",
  "description": "A label connected by a drawn line to a point of interest. The line draws itself, then the label pops in.",
  "duration_default": 4.0,
  "tags": ["callout", "arrow", "explain", "screencast"],
  "vars": {
    "text":   { "type": "text",   "default": "This is the terminal", "label": "Text" },
    "target": { "type": "point",  "default": { "x": 0.55, "y": 0.55 }, "label": "Target (fraction)" },
    "label":  { "type": "point",  "default": { "x": 0.70, "y": 0.25 }, "label": "Label position (fraction)" },
    "accent": { "type": "color",  "default": "#ffd166", "label": "Accent" },
    "size":   { "type": "number", "default": 1.0, "min": 0.5, "max": 2.5, "step": 0.1, "label": "Size" }
  }
}
