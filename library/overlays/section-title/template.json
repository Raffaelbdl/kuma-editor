{
  "id": "section-title",
  "name": "Section title",
  "description": "Big title with a subtitle and an optional dimmed backdrop. Words rise in one by one.",
  "duration_default": 4.0,
  "tags": ["title", "chapter", "section", "card"],
  "vars": {
    "title":    { "type": "string",  "default": "Chapter one", "label": "Title" },
    "subtitle": { "type": "string",  "default": "Setting things up", "label": "Subtitle" },
    "accent":   { "type": "color",   "default": "#ff4f00", "label": "Accent" },
    "align":    { "type": "enum",    "options": ["left", "center"], "default": "left", "label": "Align" },
    "dim":      { "type": "boolean", "default": true, "label": "Dim background" },
    "size":     { "type": "number",  "default": 1.0, "min": 0.5, "max": 2.5, "step": 0.1, "label": "Size" }
  }
}
