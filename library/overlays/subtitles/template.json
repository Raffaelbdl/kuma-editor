{
  "id": "subtitles",
  "name": "Subtitles",
  "description": "Timed lines, one at a time: the transcript a `transcribe` job writes, or cues typed by hand. Cue times are seconds into the source; `offset` is where the clip starts in it.",
  "duration_default": 10.0,
  "tags": ["subtitles", "captions", "shorts"],
  "vars": {
    "cues":       { "type": "cues",    "default": [ { "start": 0.2, "end": 1.6, "text": "Subtitles go here" }, { "start": 1.8, "end": 3.6, "text": "one line at a time" } ], "label": "Cues" },
    "offset":     { "type": "number",  "default": 0, "min": 0, "max": 3600, "step": 0.01, "label": "Source offset (s)", "description": "Source seconds at the clip's first frame — the media clip's `in`." },
    "at":         { "type": "point",   "default": { "x": 0.5, "y": 0.78 }, "label": "Position (fraction)" },
    "size":       { "type": "number",  "default": 1, "min": 0.5, "max": 2.5, "step": 0.1, "label": "Size" },
    "color":      { "type": "color",   "default": "#ffffff", "label": "Text" },
    "background": { "type": "color",   "default": "#111111", "label": "Box / stroke" },
    "style":      { "type": "enum",    "options": ["box", "outline", "plain"], "default": "box", "label": "Style" },
    "uppercase":  { "type": "boolean", "default": false, "label": "Uppercase" }
  }
}
