{
  "id": "vignette",
  "name": "Vignette",
  "description": "Darkened corners via ffmpeg's vignette filter.",
  "params": {
    "angle": { "type": "number", "default": 0.5, "min": 0.1, "max": 1.5, "step": 0.05, "label": "Angle (radians)" }
  },
  "effects": [ { "type": "mlt", "service": "avfilter.vignette", "properties": { "av.angle": "$angle", "av.mode": "forward" } } ]
}
