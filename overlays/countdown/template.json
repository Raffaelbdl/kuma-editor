{
  "id": "countdown",
  "name": "Countdown",
  "description": "Counts down from a number, one digit per second, with a ring that empties. Set the clip length to match.",
  "duration_default": 3.0,
  "tags": ["countdown", "timer", "intro"],
  "vars": {
    "from":   { "type": "number", "default": 3, "min": 1, "max": 60, "step": 1, "label": "Count from" },
    "accent": { "type": "color",  "default": "#ff4f00", "label": "Accent" },
    "at":     { "type": "point",  "default": { "x": 0.5, "y": 0.5 }, "label": "Position (fraction)" },
    "size":   { "type": "number", "default": 1.0, "min": 0.5, "max": 2.5, "step": 0.1, "label": "Size" }
  }
}
