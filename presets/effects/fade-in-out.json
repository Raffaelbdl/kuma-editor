{
  "id": "fade-in-out",
  "name": "Fade in / out",
  "description": "Opacity fade at both ends of the clip.",
  "params": {
    "in": { "type": "number", "default": 0.5, "min": 0, "max": 5, "step": 0.1 },
    "out": { "type": "number", "default": 0.5, "min": 0, "max": 5, "step": 0.1 }
  },
  "effects": [ { "type": "fade", "in": "$in", "out": "$out" } ]
}
