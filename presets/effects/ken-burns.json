{
  "id": "ken-burns",
  "name": "Ken Burns",
  "description": "Slow push-in over the clip: scale 1.0 → zoom with a gentle drift.",
  "params": {
    "zoom": { "type": "number", "default": 1.2, "min": 1.0, "max": 2.0, "step": 0.05 },
    "duration": { "type": "number", "default": 6, "min": 0.5, "max": 60, "step": 0.5, "label": "Seconds" },
    "drift_x": { "type": "number", "default": -40, "min": -400, "max": 400, "step": 10 },
    "drift_y": { "type": "number", "default": -20, "min": -400, "max": 400, "step": 10 }
  },
  "effects": [
    { "type": "transform", "keyframes": [
      { "t": 0, "scale": 1.0, "x": 0, "y": 0 },
      { "t": "$duration", "scale": "$zoom", "x": "$drift_x", "y": "$drift_y" }
    ] }
  ]
}
