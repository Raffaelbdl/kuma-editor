{
  "id": "pip-corner",
  "name": "Picture-in-picture",
  "description": "Shrink the clip into a corner (webcam over a screen recording). Offsets are from the frame centre.",
  "params": {
    "scale": { "type": "number", "default": 0.28, "min": 0.1, "max": 0.6, "step": 0.02 },
    "x": { "type": "number", "default": 640, "min": -1000, "max": 1000, "step": 10 },
    "y": { "type": "number", "default": 340, "min": -600, "max": 600, "step": 10 },
    "radius": { "type": "number", "default": 0.08, "min": 0, "max": 0.5, "step": 0.01, "label": "Corner radius" }
  },
  "effects": [
    { "type": "crop", "radius": "$radius" },
    { "type": "transform", "scale": "$scale", "x": "$x", "y": "$y" }
  ]
}
